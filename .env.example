# URL de l'API. Laisser vide en développement : l'app détecte automatiquement
# l'IP du PC via Expo Go. En production : https://api.mon-domaine.ml
EXPO_PUBLIC_API_URL=

# Google OAuth — Client ID de type « Web » obligatoire.
# Sur Expo Go, ajoute aussi l'URI de redirection affichée dans Google Cloud Console.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
