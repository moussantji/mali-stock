# Serveur API
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=*

# Secret JWT (générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mali_app
DB_PASSWORD=change-me
DB_NAME=mali_stock
DB_CONNECTION_LIMIT=10

# Compte root MySQL pour les scripts d'administration
DB_ROOT_USER=root
DB_ROOT_PASSWORD=change-me

# Google OAuth : Client IDs séparés par des virgules
GOOGLE_CLIENT_IDS=

# MySQL portable (laisser vide si MySQL est installé en service)
MYSQL_HOME=
MYSQL_DATA_DIR=
MYSQL_PORT=3306
