{
  "name": "mali-stock-bogolan-tricolore",
  "version": "1.0.0",
  "description": "Application mobile malienne de gestion de stock — Palette 04 Bogolan Tricolore Premium (vert, jaune or, rouge latérite)",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "api": "npm --prefix server run dev",
    "db:setup": "npm --prefix server run db:setup",
    "db:start": "npm --prefix server run db:start",
    "db:stop": "npm --prefix server run db:stop"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~58.0.19",
    "expo-auth-session": "~58.0.14",
    "expo-camera": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "^58.0.20",
    "typescript": "~6.0.3"
  },
  "private": true
}
